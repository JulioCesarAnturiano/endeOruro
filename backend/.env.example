# Copia este archivo como .env y pon tu clave. El .env nunca se sube al repositorio.
OPENAI_API_KEY=sk-...

# Modelo de voz en tiempo real y voz del personaje
OPENAI_REALTIME_MODEL=gpt-realtime
# Voz anterior (seria y grave): cedar
# Otras opciones: marin, alloy, ash, ballad, echo, sage, verse, shimmer
OPENAI_VOICE=coral

PORT=3001
